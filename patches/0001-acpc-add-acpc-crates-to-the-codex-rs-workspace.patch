From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AkaraChen <akarachen@outlook.com>
Date: Sun, 8 Nov 2026 09:30:10 +0100
Subject: [PATCH] acpc: add acpc crates to the codex-rs workspace

Also drop the V8-based members (code-mode-host, code-mode-runtime,
v8-poc) and the rusty_v8 git override. acpc never builds them, but cargo
clones every git dependency of the workspace, with its submodules (all
of V8), before it can build anything.
---
 codex-rs/Cargo.toml | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/codex-rs/Cargo.toml b/codex-rs/Cargo.toml
index 4b6168b..eeb73f6 100644
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -1,5 +1,10 @@
 [workspace]
 members = [
+    # acpc crates live outside the upstream tree (see acpc's patches/).
+    "../../../crates/acp-client",
+    "../../../crates/acp-bridge",
+    "../../../crates/acpc",
+    "../../../crates/mock-agent",
     "aws-auth",
     "analytics",
     "agent-graph-store",
@@ -29,9 +34,7 @@ members = [
     "install-context",
     "codex-backend-openapi-models",
     "code-mode",
-    "code-mode-host",
     "code-mode-protocol",
-    "code-mode-runtime",
     "plugin-host",
     "codex-home",
     "cloud-config",
@@ -122,7 +125,6 @@ members = [
     "user-input",
     "user-verification",
     "tools",
-    "v8-poc",
     "websocket-auth",
     "websocket-client",
     "windows-sandbox-rs/tests/support",
@@ -696,7 +698,6 @@ sqlx-core = { git = "https://github.com/transact-rs/sqlx", rev = "10462fa4414c6c
 sqlx-sqlite = { git = "https://github.com/transact-rs/sqlx", rev = "10462fa4414c6c7f1ed1d39bb31678e3b726878c" }
 tokio-tungstenite = { git = "https://github.com/openai-oss-forks/tokio-tungstenite", rev = "7a920470d62138955446b64220c7609e46ad770e" }
 tungstenite = { git = "https://github.com/openai-oss-forks/tungstenite-rs", rev = "e19950ef7828cb311e6d51a6bedcebf0192e055c" }
-v8 = { git = "https://github.com/openai-oss-forks/rusty_v8.git", rev = "90a65f887a0c0f048f3784afbcb320b373c8a2e0" }
 
 # Uncomment to debug local changes.
 # rmcp = { path = "../../rust-sdk/crates/rmcp" }
