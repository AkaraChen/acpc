+
+fn status_of(items: &[&str], separators: &[&str]) -> StatusLine {
+    let mut line = HyperlinkLine::default();
+    for (index, item) in items.iter().enumerate() {
+        if index > 0 {
+            line.push_span(
+                separators[index - 1].to_string().into(),
+                /*destination*/ None,
+            );
+        }
+        line.push_span(item.to_string().into(), /*destination*/ None);
+    }
+    StatusLine::from(line)
+}
+
+fn rendered_rows(status: &StatusLine, width: u16, height: u16) -> Vec<String> {
+    let rows = status.height(Size { width, height });
+    let area = Rect::new(/*x*/ 0, /*y*/ 0, width, rows);
+    let mut buf = Buffer::empty(area);
+    status.render(area, &mut buf, StatusLineFocus::Focused);
+    (0..rows)
+        .map(|y| {
+            (0..width)
+                .map(|x| buf[(x, y)].symbol().replace('\u{a0}', " "))
+                .collect::<String>()
+                .trim_end()
+                .to_string()
+        })
+        .collect()
+}
+
+#[test]
+fn row_breaks_start_new_rows_even_when_the_line_fits() {
+    let status = status_of(
+        &["gpt-5 high", "Context 80% left", "~/repo", "main"],
+        &[
+            STATUS_LINE_SEPARATOR,
+            STATUS_LINE_ROW_BREAK,
+            STATUS_LINE_SEPARATOR,
+        ],
+    );
+    assert_eq!(
+        rendered_rows(&status, /*width*/ 80, /*height*/ 3),
+        ["gpt-5 high · Context 80% left", "~/repo · main"]
+    );
+}
+
+#[test]
+fn row_breaks_read_as_separators_on_a_single_row() {
+    let status = status_of(&["gpt-5", "~/repo"], &[STATUS_LINE_ROW_BREAK]);
+    assert_eq!(
+        rendered_rows(&status, /*width*/ 80, /*height*/ 1),
+        ["gpt-5 · ~/repo"]
+    );
+}
+
+#[test]
+fn overflow_wraps_between_items_without_splitting_them() {
+    let status = status_of(
+        &["Ask for approval", "Custom permissions", "0 in", "0 out"],
+        &[STATUS_LINE_SEPARATOR; 3],
+    );
+    assert_eq!(
+        rendered_rows(&status, /*width*/ 30, /*height*/ 3),
+        ["Ask for approval", "Custom permissions · 0 in", "0 out"]
+    );
+}
+
+#[test]
+fn an_item_wider_than_the_row_still_wraps_at_words() {
+    let status = status_of(&["one two three four", "five"], &[STATUS_LINE_SEPARATOR]);
+    assert_eq!(
+        rendered_rows(&status, /*width*/ 10, /*height*/ 4),
+        ["one two", "three four", "five"]
+    );
+}
+
+#[test]
+fn rows_past_the_limit_end_with_an_ellipsis() {
+    let status = status_of(&["alpha", "beta", "gamma"], &[STATUS_LINE_ROW_BREAK; 2]);
+    assert_eq!(
+        rendered_rows(&status, /*width*/ 20, /*height*/ 2),
+        ["alpha", "beta…"]
+    );
+}
