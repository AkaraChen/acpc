+
+/// Splits a status line into rows: a new row at every row break, and otherwise
+/// as many whole items per row as fit. Items are never split across rows
+/// unless a single item is wider than the row, which then wraps at words.
+fn layout_rows(status: &HyperlinkLine, bounds: Size) -> Vec<HyperlinkLine> {
+    let width = usize::from(bounds.width);
+    // Same lookahead budget as `wrap_rows`, so the last visible row knows it is cut off.
+    let limit = usize::from(bounds.height) + 1;
+    let spans = &status.line.spans;
+    let mut columns = Vec::with_capacity(spans.len() + 1);
+    let mut column = 0;
+    for span in spans {
+        columns.push(column);
+        column += display_width(&span.content);
+    }
+    columns.push(column);
+    let span_width = |range: &Range<usize>| columns[range.end] - columns[range.start];
+
+    let mut rows = Vec::new();
+    let mut row = 0..0;
+    let mut item_start = 0;
+    let mut pending_separator: Option<usize> = None;
+    let flush = |row: Range<usize>, rows: &mut Vec<HyperlinkLine>| {
+        if row.is_empty() || rows.len() >= limit {
+            return;
+        }
+        let piece = HyperlinkLine {
+            line: Line {
+                spans: spans[row.clone()].to_vec(),
+                ..status.line.clone()
+            },
+            hyperlinks: project_hyperlink_columns(
+                &status.hyperlinks,
+                columns[row.start]..columns[row.end],
+                /*prefix*/ 0,
+            ),
+            source: None,
+        };
+        if piece.width() > width {
+            rows.extend(wrap_rows(&piece, bounds));
+        } else {
+            rows.push(piece);
+        }
+        rows.truncate(limit);
+    };
+    for index in 0..=spans.len() {
+        let separator = spans.get(index).map(|span| span.content.as_ref());
+        let is_separator = matches!(
+            separator,
+            Some(STATUS_LINE_SEPARATOR) | Some(STATUS_LINE_ROW_BREAK)
+        );
+        if !is_separator && index < spans.len() {
+            continue;
+        }
+        // `item_start..index` is one item; place it after the pending separator or on a new row.
+        let item = item_start..index;
+        match pending_separator {
+            None => row = item,
+            Some(separator) => {
+                let joined = row.start..item.end;
+                let hard = spans[separator].content == STATUS_LINE_ROW_BREAK;
+                if !hard && span_width(&joined) <= width {
+                    row = joined;
+                } else {
+                    flush(std::mem::replace(&mut row, item), &mut rows);
+                }
+            }
+        }
+        pending_separator = is_separator.then_some(index);
+        item_start = index + 1;
+    }
+    flush(row, &mut rows);
+    rows
+}
