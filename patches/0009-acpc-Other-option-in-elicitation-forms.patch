+    /// acpc: the form claude-agent-acp sends for AskUserQuestion: each
+    /// question is a select plus an optional free-text "Other" field.
+    fn ask_user_question_request(
+        tx: AppEventSender,
+        properties: Value,
+        other_fields: Value,
+    ) -> McpServerElicitationOverlay {
+        let request = from_form_request(
+            ThreadId::default(),
+            form_request(
+                "Please answer the following questions.",
+                serde_json::json!({"type": "object", "properties": properties}),
+                Some(serde_json::json!({ACPC_OTHER_FIELDS_META_KEY: other_fields})),
+            ),
+        )
+        .expect("supported form");
+        McpServerElicitationOverlay::new(
+            request, tx, /*has_input_focus*/ true, /*enhanced_keys_supported*/ false,
+            /*disable_paste_burst*/ true,
+        )
+    }
+
+    fn select_question(title: &str) -> Value {
+        serde_json::json!({
+            "type": "string",
+            "title": title,
+            "oneOf": [
+                {"const": "Postgres", "title": "Postgres"},
+                {"const": "SQLite", "title": "SQLite"},
+            ],
+        })
+    }
+
+    fn other_box() -> Value {
+        serde_json::json!({"type": "string", "title": "Other"})
+    }
+
+    fn submitted_content(rx: &mut UnboundedReceiver<AppEvent>) -> Value {
+        let Ok(AppEvent::SubmitThreadOp { op, .. }) = rx.try_recv() else {
+            panic!("expected a submitted answer");
+        };
+        let Op::ResolveElicitation {
+            decision, content, ..
+        } = op
+        else {
+            panic!("expected ResolveElicitation");
+        };
+        assert_eq!(decision, McpServerElicitationAction::Accept);
+        content.expect("content")
+    }
+
+    #[test]
+    fn picking_a_listed_option_skips_the_other_box() {
+        let (tx, mut rx) = test_sender();
+        let mut overlay = ask_user_question_request(
+            tx,
+            serde_json::json!({
+                "question_0": select_question("Database"),
+                "question_0_custom": other_box(),
+                "question_1": select_question("Cache"),
+                "question_1_custom": other_box(),
+            }),
+            serde_json::json!({
+                "question_0": "question_0_custom",
+                "question_1": "question_1_custom",
+            }),
+        );
+        assert_eq!(overlay.shown_field_progress(), (1, 2));
+        assert_eq!(
+            overlay
+                .current_options()
+                .iter()
+                .map(|option| option.label.as_str())
+                .collect::<Vec<_>>(),
+            vec!["Postgres", "SQLite", "Other"]
+        );
+
+        overlay.handle_key_event(KeyCode::Enter.into());
+        assert_eq!(
+            overlay.current_field().map(|f| f.id.as_str()),
+            Some("question_1")
+        );
+        assert_eq!(overlay.shown_field_progress(), (2, 2));
+        overlay.handle_key_event(KeyCode::Char('2').into());
+
+        assert_eq!(
+            submitted_content(&mut rx),
+            serde_json::json!({"question_0": "Postgres", "question_1": "SQLite"})
+        );
+    }
+
+    #[test]
+    fn picking_other_asks_for_the_typed_answer() {
+        let (tx, mut rx) = test_sender();
+        let mut overlay = ask_user_question_request(
+            tx,
+            serde_json::json!({
+                "question_0": select_question("Database"),
+                "question_0_custom": other_box(),
+            }),
+            serde_json::json!({"question_0": "question_0_custom"}),
+        );
+        overlay.handle_key_event(KeyCode::Char('3').into());
+        assert_eq!(
+            overlay.current_field().map(|f| f.id.as_str()),
+            Some("question_0_custom")
+        );
+        assert_eq!(overlay.shown_field_progress(), (2, 2));
+        overlay.handle_paste("MySQL".to_string());
+        overlay.handle_key_event(KeyCode::Enter.into());
+
+        assert_eq!(
+            submitted_content(&mut rx),
+            serde_json::json!({"question_0_custom": "MySQL"})
+        );
+    }
+
+    #[test]
+    fn multi_select_other_is_a_checkbox_that_leads_to_the_box() {
+        let (tx, mut rx) = test_sender();
+        let mut overlay = ask_user_question_request(
+            tx,
+            serde_json::json!({
+                "question_0": {
+                    "type": "array",
+                    "title": "Features",
+                    "items": {"anyOf": [
+                        {"const": "Auth", "title": "Auth"},
+                        {"const": "Search", "title": "Search"},
+                    ]},
+                },
+                "question_0_custom": other_box(),
+            }),
+            serde_json::json!({"question_0": "question_0_custom"}),
+        );
+        overlay.handle_key_event(KeyCode::Char('1').into());
+        overlay.handle_key_event(KeyCode::Char('3').into());
+        overlay.handle_key_event(KeyCode::Enter.into());
+        assert_eq!(
+            overlay.current_field().map(|f| f.id.as_str()),
+            Some("question_0_custom")
+        );
+        overlay.handle_paste("Billing".to_string());
+        overlay.handle_key_event(KeyCode::Enter.into());
+
+        assert_eq!(
+            submitted_content(&mut rx),
+            serde_json::json!({"question_0": ["Auth"], "question_0_custom": "Billing"})
+        );
+    }
+
+    #[test]
+    fn forms_without_other_fields_keep_every_field() {
+        let (tx, _rx) = test_sender();
+        let request = from_form_request(
+            ThreadId::default(),
+            form_request(
+                "Two questions",
+                serde_json::json!({
+                    "type": "object",
+                    "properties": {
+                        "question_0": select_question("Database"),
+                        "question_0_custom": other_box(),
+                    },
+                }),
+                /*meta*/ None,
+            ),
+        )
+        .expect("supported form");
+        let overlay = McpServerElicitationOverlay::new(
+            request, tx, /*has_input_focus*/ true, /*enhanced_keys_supported*/ false,
+            /*disable_paste_burst*/ true,
+        );
+        assert_eq!(overlay.shown_field_progress(), (1, 2));
+        assert_eq!(overlay.current_options().len(), 2);
+    }
 }
