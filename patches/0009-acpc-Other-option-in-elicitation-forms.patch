+/// acpc: pair each select with its free-text "Other" field (named by the bridge
+/// in `_meta`) and give the select an "Other" option. The Other field is only
+/// asked for once that option is picked, so choosing a listed option no longer
+/// leads to a text box, and each question counts as one field.
+fn link_other_fields(
+    meta: Option<&Value>,
+    fields: &mut [McpServerElicitationField],
+) -> Vec<(usize, usize)> {
+    let Some(pairs) = meta
+        .and_then(|meta| meta.get(ACPC_OTHER_FIELDS_META_KEY))
+        .and_then(Value::as_object)
+    else {
+        return Vec::new();
+    };
+    let mut links = Vec::new();
+    for (select_id, other_id) in pairs {
+        let Some(other_id) = other_id.as_str() else {
+            continue;
+        };
+        let Some(other_idx) = fields.iter().position(|field| {
+            field.id == other_id
+                && matches!(field.input, McpServerElicitationFieldInput::Text { .. })
+        }) else {
+            continue;
+        };
+        let Some(select_idx) = fields.iter().position(|field| &field.id == select_id) else {
+            continue;
+        };
+        let Some(select) = fields.get_mut(select_idx) else {
+            continue;
+        };
+        let options = match &mut select.input {
+            McpServerElicitationFieldInput::Select { options, .. }
+            | McpServerElicitationFieldInput::MultiSelect { options, .. } => options,
+            _ => continue,
+        };
+        options.push(McpServerElicitationOption {
+            label: "Other".to_string(),
+            description: Some("Type your own answer".to_string()),
+            value: Value::String(ACPC_OTHER_OPTION_VALUE.to_string()),
+        });
+        links.push((select_idx, other_idx));
+    }
+    links
+}
+
+fn is_other_option(option: &McpServerElicitationOption) -> bool {
+    option.value.as_str() == Some(ACPC_OTHER_OPTION_VALUE)
+}
