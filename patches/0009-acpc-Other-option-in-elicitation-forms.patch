+    /// acpc: the select whose "Other" option leads to field `idx`, if any.
+    fn other_field_owner(&self, idx: usize) -> Option<usize> {
+        self.request
+            .other_fields
+            .iter()
+            .find(|(_, other)| *other == idx)
+            .map(|(select, _)| *select)
+    }
+
+    /// acpc: whether the "Other" option of select `idx` is picked.
+    fn other_option_picked(&self, idx: usize) -> bool {
+        let (Some(field), Some(answer)) = (self.request.fields.get(idx), self.answers.get(idx))
+        else {
+            return false;
+        };
+        match &field.input {
+            McpServerElicitationFieldInput::Select { options, .. } => {
+                answer.answer_committed
+                    && answer
+                        .selection
+                        .selected_idx
+                        .and_then(|selected| options.get(selected))
+                        .is_some_and(is_other_option)
+            }
+            McpServerElicitationFieldInput::MultiSelect { options, .. } => options
+                .iter()
+                .zip(&answer.checked)
+                .any(|(option, checked)| *checked && is_other_option(option)),
+            _ => false,
+        }
+    }
+
+    /// acpc: an "Other" field is shown only while its select has Other picked.
+    fn is_field_shown(&self, idx: usize) -> bool {
+        self.other_field_owner(idx)
+            .is_none_or(|select| self.other_option_picked(select))
+    }
+
+    /// acpc: the next shown field after the current one.
+    fn next_shown_field(&self) -> Option<usize> {
+        (self.current_index() + 1..self.field_count()).find(|idx| self.is_field_shown(*idx))
+    }
+
+    /// acpc: shown fields, and the current one's position among them.
+    fn shown_field_progress(&self) -> (usize, usize) {
+        let shown = (0..self.field_count())
+            .filter(|idx| self.is_field_shown(*idx))
+            .count();
+        let position = (0..=self.current_index())
+            .filter(|idx| self.is_field_shown(*idx))
+            .count();
+        (position.max(1), shown)
+    }
