From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jimmy <tliang92@gmail.com>
Date: Sat, 21 Nov 2026 21:19:02 +0800
Subject: [PATCH] acpc: move status line items past hidden rows with the arrow
 keys

In the /statusline picker a shown item now swaps with the next shown item
instead of the next row, so a line break enabled at the bottom of the list
reaches its place in a press or two. The line break rows say how to use them.
---
 .../src/bottom_pane/multi_select_picker.rs    | 82 ++++++++++++++++++-
 ...nders_checkboxes_preview_and_overflow.snap | 28 +++----
 .../tui/src/bottom_pane/status_line_setup.rs  |  8 +-
 3 files changed, 98 insertions(+), 20 deletions(-)

diff --git a/codex-rs/tui/src/bottom_pane/multi_select_picker.rs b/codex-rs/tui/src/bottom_pane/multi_select_picker.rs
index a97597c..aa3afaf 100644
--- a/codex-rs/tui/src/bottom_pane/multi_select_picker.rs
+++ b/codex-rs/tui/src/bottom_pane/multi_select_picker.rs
@@ -465,10 +465,27 @@ impl MultiSelectPicker {
             return;
         }
 
-        let new_idx = match direction {
-            Direction::Up if actual_idx > 0 => actual_idx - 1,
-            Direction::Down if actual_idx + 1 < len => actual_idx + 1,
-            _ => return,
+        // A shown item passes the next shown one and skips the hidden rows between: the order
+        // that matters is the order of what is shown, and a row that starts disabled (a line
+        // break, for one) would otherwise need a key press per hidden row to reach its place.
+        let step = |from: usize| match direction {
+            Direction::Up => from.checked_sub(1),
+            Direction::Down => Some(from + 1).filter(|next| *next < len),
+        };
+        let shown = self.items[actual_idx].enabled;
+        let mut new_idx = step(actual_idx);
+        if shown {
+            while let Some(idx) = new_idx
+                && self
+                    .items
+                    .get(idx)
+                    .is_some_and(|item| item.orderable && !item.enabled)
+            {
+                new_idx = step(idx);
+            }
+        }
+        let Some(new_idx) = new_idx else {
+            return;
         };
 
         if !self.items.get(new_idx).is_some_and(|item| item.orderable) {
@@ -1004,6 +1021,63 @@ pub(super) mod tests {
         );
     }
 
+    #[test]
+    fn a_shown_item_skips_hidden_rows_when_moved() {
+        let shown = |id: &str| MultiSelectItem {
+            enabled: true,
+            ..item(
+                id, /*orderable*/ true, /*section_break_after*/ false,
+            )
+        };
+        let hidden = |id: &str| {
+            item(
+                id, /*orderable*/ true, /*section_break_after*/ false,
+            )
+        };
+        let ids = |picker: &MultiSelectPicker| {
+            picker
+                .items
+                .iter()
+                .map(|item| item.id.clone())
+                .collect::<Vec<_>>()
+        };
+        // Shown: model, branch, break. Hidden rows sit between and after them.
+        let mut picker = test_picker(vec![
+            shown("model"),
+            shown("branch"),
+            hidden("a"),
+            hidden("b"),
+            hidden("c"),
+            shown("break"),
+            hidden("d"),
+        ]);
+        picker.state.selected_idx = Some(5);
+
+        picker.move_selected_item(Direction::Up);
+        assert_eq!(
+            ids(&picker),
+            ["model", "break", "a", "b", "c", "branch", "d"]
+        );
+        picker.move_selected_item(Direction::Up);
+        assert_eq!(
+            ids(&picker),
+            ["break", "model", "a", "b", "c", "branch", "d"]
+        );
+        // Already first among the shown ones.
+        picker.move_selected_item(Direction::Up);
+        assert_eq!(
+            ids(&picker),
+            ["break", "model", "a", "b", "c", "branch", "d"]
+        );
+        // The last shown one does not walk off through the hidden rows.
+        picker.state.selected_idx = Some(5);
+        picker.move_selected_item(Direction::Down);
+        assert_eq!(
+            ids(&picker),
+            ["break", "model", "a", "b", "c", "branch", "d"]
+        );
+    }
+
